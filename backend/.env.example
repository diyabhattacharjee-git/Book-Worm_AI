# Copy to backend/.env and fill in only what you need. Everything except
# APP_SECRET_KEY is optional: the app runs fully offline with none of these set.

APP_ENV=development
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (>= 32 chars) when APP_ENV=production. In development a temporary
# random secret is used if this is empty (you'll be logged out on restart).
APP_SECRET_KEY=

# SQLite by default (zero setup). For PostgreSQL (e.g. Neon) paste its connection string as-is:
#   DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./book_platform.db

# Comma-separated list of allowed browser origins (the Vite dev server by default).
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------- email (one-time codes)
# Required for sign-up / email sign-in codes to reach real inboxes. Free options:
#  * Gmail: turn on 2-Step Verification, create an App Password (myaccount.google.com/apppasswords),
#    then SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USERNAME=you@gmail.com SMTP_PASSWORD=<app password>
#    SMTP_FROM="BookWorm <you@gmail.com>"   (Gmail allows a few hundred emails/day)
#  * Brevo free tier: SMTP_HOST=smtp-relay.brevo.com, credentials from your Brevo account.
# Without SMTP, development prints codes to the backend log; production refuses to sign people up.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ------------------------------------------------------------ Google sign-in
# OAuth 2.0 Client ID (type "Web application") from console.cloud.google.com > APIs & Services >
# Credentials. Add http://localhost:5173 (and your real domain) to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Developer API docs at /api/docs (keep false for real users).
ENABLE_API_DOCS=false

# ---------------------------------------------------------------- optional LLMs
# Tried in this order; unconfigured providers are skipped. Never required.
LLM_PROVIDER_ORDER=groq,huggingface,ollama

# Groq (free API key at console.groq.com > API Keys). Suggested models:
# llama-3.1-8b-instant (fast) or llama-3.3-70b-versatile. Check console.groq.com/docs/models.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant   # or openai/gpt-oss-120b / openai/gpt-oss-20b

# Hugging Face Inference Providers (free accounts get small monthly credits; no charges without billing).
# A good non-gated choice: openai/gpt-oss-20b
HF_TOKEN=
HF_MODEL=
HF_PROVIDER=auto

# Ollama running locally (fully free, needs enough RAM), e.g. OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# ------------------------------------------------------------ optional metadata
# Without a key Google Books uses a shared anonymous quota that is often exhausted.
# A free key (Google Cloud console, Books API) avoids that. Open Library needs no key.
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_COUNTRY=IN
ENABLE_OPEN_LIBRARY=true
ENABLE_GOOGLE_BOOKS=true

# Optional local embeddings: pip install -r requirements-ml.txt, then set to sentence-transformers
EMBEDDINGS_BACKEND=tfidf

# --------------------------------------------------------------- optional eBay
# Free developer account at developer.ebay.com. Sandbox returns test data only.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=sandbox
EBAY_MARKETPLACE_ID=EBAY_US

# ------------------------------------------------------------ price intelligence
DEFAULT_CURRENCY=INR
# Currencies are never mixed unless you set explicit rates, e.g. {"USD_INR": 83.0}
FX_RATES_JSON=

# ------------------------------------------------- recommender weights (docs/RECOMMENDER.md)
REC_WEIGHT_CONTENT=0.40
REC_WEIGHT_COLLABORATIVE=0.25
REC_WEIGHT_POPULARITY=0.15
REC_WEIGHT_PREFERENCE=0.20
REC_DIVERSITY_LAMBDA=0.80
REC_RECENCY_HALF_LIFE_DAYS=60

# Image storage. Set CLOUDINARY_URL (free Cloudinary account > Dashboard > API environment variable,
# format cloudinary://<api_key>:<api_secret>@<cloud_name>) to store photos in Cloudinary; required on
# Vercel, whose filesystem is temporary. Empty = local UPLOAD_DIR.
CLOUDINARY_URL=

# Uploads (local disk). On hosts with ephemeral disks uploads vanish on redeploy.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Optional single-service mode: serve the built frontend (npm run build) from FastAPI.
FRONTEND_DIST=
